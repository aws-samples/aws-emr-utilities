# EMR Serverless Config Advisor - Environment Configuration Template
# Copy this file to .env and fill in your specific values
# DO NOT commit .env file to git - it contains sensitive information

# ============================================================================
# AWS Configuration
# ============================================================================
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
AWS_PROFILE=default

# ============================================================================
# S3 Storage
# ============================================================================
S3_BUCKET=spark-history-${AWS_ACCOUNT_ID}-${AWS_REGION}
S3_ADVISOR_PATH=s3://${S3_BUCKET}/emr-serverless-config-advisor/
S3_DEPENDENCIES_PATH=s3://${S3_BUCKET}/pipeline-files/dependencies/pyspark_venv.tar.gz
S3_SCRIPTS_PREFIX=pipeline-files/backlog-scale
ICEBERG_WAREHOUSE=s3://${S3_BUCKET}/iceberg/

# ============================================================================
# EMR Serverless Application
# ============================================================================
EMR_SERVERLESS_APPLICATION_ID=00gxxxxxxxxx
EMR_SERVERLESS_APPLICATION_NAME=emr-serverless-spark-app
IAM_EXECUTION_ROLE_ARN=arn:aws:iam::${AWS_ACCOUNT_ID}:role/EMRServerlessExecutionRole

# Backfill Application (optional - for separate backfill cluster)
EMR_APPLICATION_ID_BACKFILL=00gyyyyyyyyyy

# ============================================================================
# Data Catalog & Tables
# ============================================================================
CATALOG_NAMESPACE=your_database.your_schema
BACKLOG_TABLE=${CATALOG_NAMESPACE}.backlog_events_log
DYNAMODB_TABLE_NAME=emr-serverless-config-advisor

# Hive Metastore (if using external HMS instead of Glue)
HMS_URI=thrift://localhost:9083

# ============================================================================
# Processing Configuration
# ============================================================================

# Discovery Settings
LOOKBACK_HOURS=2              # Scan logs from last N hours
TEST_LIMIT=0                  # 0 = no limit, N = process only N logs (for testing)

# Job Submission Limits
MAX_CONCURRENT_JOBS=500       # Max jobs to submit per orchestrator run
MAX_JOBS_PER_RUN=1500         # Total job cap per run

# Capacity Management (prevents cluster overload)
CAPACITY_MAX_CONCURRENT=500   # Max concurrent running jobs before waiting
CAPACITY_CHECK_INTERVAL=300   # Seconds to wait between capacity checks (5 min)
CAPACITY_SAFE_BUFFER=50       # Reserved slots as safety buffer

# Throttling (prevents API rate limits)
SUBMISSION_DELAY_SECONDS=20   # Brief pause every 100 submissions
LONG_SLEEP_AFTER_JOBS=250     # After N jobs, take long sleep
LONG_SLEEP_SECONDS=600        # Long sleep duration (10 min)

# ============================================================================
# Performance Tuning
# ============================================================================

# Bulk Loading (25_bulk_load_metrics_to_iceberg.py)
BATCH_SIZE=500                # Records per Iceberg write batch
MAX_WORKERS=40                # Parallel S3 reads (based on server cores)

# EMR Job Configuration
LOGS_PER_JOB=5                # Event logs per EMR Serverless job

# ============================================================================
# Optional: Assume Role (for cross-account access)
# ============================================================================
# ASSUME_ROLE_ARN=arn:aws:iam::ANOTHER_ACCOUNT:role/CrossAccountRole
